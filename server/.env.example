#
# Copy this file to `.env` (never commit .env) and fill in your real key.
# The key lives ONLY on the server and is NEVER exposed to the browser.

# Your Anthropic API key. Get one at https://console.anthropic.com/
# It starts with "sk-ant-". DO NOT put the real value in the repo or the browser.
ANTHROPIC_API_KEY=<your-anthropic-api-key-here>

# Model to use (Claude Opus 5 by default).
ANTHROPIC_MODEL=claude-opus-5

# Port the proxy listens on.
PORT=8787

# Allowed browser origin for CORS (use your site origin in production; "*" for local dev).
CORS_ORIGIN=*
